GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_API_KEY=votre_cle_api_google_ici
GOOGLE_MODEL=gemini-2.5-pro

# --- APIs sans clé (utilisées automatiquement) ---
# Nominatim (OpenStreetMap) : géocodage de villes
# ExchangeRate-API : taux de change en temps réel
# Overpass API (OpenStreetMap) : attractions, restaurants, POI

# OpenWeatherMap : prévisions météo 5 jours (1000 appels/jour gratuit)
# Inscription : https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=votre_cle_openweathermap_ici

# Aviationstack : recherche de vrais vols (100 appels/mois gratuit)
# Inscription : https://aviationstack.com/
AVIATIONSTACK_API_KEY=votre_cle_aviationstack_ici
